ACCOUNT_MODE=proxy
ACCOUNT_ORIGIN=https://sophialearn.ru
ACCOUNT_DB_PATH=/var/lib/sophia/accounts.sqlite
ACCOUNT_REGISTRATION_ENABLED=false
AI_CHAT_ENABLED=false
CHAT_ACCESS_MODE=proxy
CHAT_LEDGER_PATH=/var/lib/sophia/ledger.sqlite
# Set in the root-only production.env and mirror in the root-only Nginx include.
# CHAT_PROXY_SECRET=
# Configure verified Postbox SMTP if sending account mail.
# ACCOUNT_MAIL_TRANSPORT=smtp
# SMTP_HOST=postbox.cloud.yandex.net
# SMTP_PORT=587
# SMTP_FROM=
# SMTP_USER=
# SMTP_PASSWORD=
