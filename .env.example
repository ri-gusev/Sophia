# Server-side OpenAI integration. Copy these entries to .env.local.
# Never prefix the key with NEXT_PUBLIC_.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Offline index and runtime retrieval must use the same model/dimensions/chunk settings.
PLATO_RAG_ENABLED=true
PLATO_CHUNK_SIZE=800
PLATO_CHUNK_OVERLAP=200
PLATO_EMBEDDING_DIMENSIONS=1536
PLATO_VECTOR_TOP_K=12
PLATO_KEYWORD_TOP_K=12
PLATO_FINAL_CONTEXT_K=6
PLATO_CONTEXT_CHARS=18000
PLATO_RETRIEVAL_THRESHOLD=0.25
PLATO_VALIDATION_ENABLED=true
PLATO_HISTORICAL_MODE=true
