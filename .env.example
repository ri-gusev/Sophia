# Accounts and progress. For public mode see docs/development/ACCOUNT_SERVER.md.
ACCOUNT_MODE=local
ACCOUNT_ORIGIN=http://127.0.0.1:3000
# Use an absolute path on persistent storage in proxy mode.
# ACCOUNT_DB_PATH=
# Public HTTPS requires ACCOUNT_MODE=proxy and a verified sender domain.
# ACCOUNT_MAIL_TRANSPORT=resend
# ACCOUNT_MAIL_FROM=Sophia <accounts@example.com>
RESEND_API_KEY=
# Fake mail is local only. Use an absolute path in a private test directory.
# ACCOUNT_MAIL_TRANSPORT=test
# ACCOUNT_TEST_OUTBOX=

# Server-side OpenAI integration. Copy these entries to .env.local.
# Never prefix the key with NEXT_PUBLIC_.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini-2026-03-17
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Local loopback only. For public use see docs/development/CHAT_SERVER.md.
CHAT_ACCESS_MODE=local
CHAT_ALLOWED_ORIGINS=http://127.0.0.1:3000
# Required in proxy mode. Supply the absolute path to a persistent SQLite file.
# CHAT_LEDGER_PATH=
# Required in proxy mode. Supply the same 64 hexadecimal characters to the proxy.
# CHAT_PROXY_SECRET=
CHAT_MAX_TURN_USD=1.85
CHAT_DAY_BUDGET_USD=5
CHAT_MONTH_BUDGET_USD=20
CHAT_CLIENT_PER_MINUTE=5
CHAT_CLIENT_PER_DAY=40
CHAT_CLIENT_BURST=2
CHAT_CLIENT_CONCURRENT=1
CHAT_GLOBAL_PER_MINUTE=20
CHAT_GLOBAL_CONCURRENT=2
CHAT_PAID_CONCURRENT=2
# Offline index and runtime retrieval must use the same model/dimensions/chunk settings.
PLATO_RAG_ENABLED=true
PLATO_CHUNK_SIZE=800
PLATO_CHUNK_OVERLAP=200
PLATO_EMBEDDING_DIMENSIONS=1536
PLATO_VECTOR_TOP_K=12
PLATO_KEYWORD_TOP_K=12
PLATO_FINAL_CONTEXT_K=6
PLATO_CONTEXT_CHARS=18000
PLATO_RETRIEVAL_THRESHOLD=0.25
PLATO_VALIDATION_ENABLED=true
PLATO_HISTORICAL_MODE=true
